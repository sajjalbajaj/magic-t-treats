# ---------------------------------------------------------------------------
# Magic T-treats — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Absolute public origin of the site. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL + anon key are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key bypasses RLS. SERVER ONLY. Must never be prefixed with
# NEXT_PUBLIC_ and must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Social / enquiry destinations -----------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/magicttreats_/
NEXT_PUBLIC_INSTAGRAM_USERNAME=magicttreats_

# Optional. When set, a WhatsApp enquiry destination becomes available.
# Digits only, including country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analytics --------------------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_ID=
